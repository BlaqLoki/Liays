# Template only — NEVER put real keys in this file. It is committed to git.
# Copy it to .env.local (which is gitignored) and fill in the real values there.
# For production, set these in Vercel: Project Settings > Environment Variables.

# Get an API key at https://resend.com
RESEND_API_KEY=

# Where contact form submissions are delivered.
CONTACT_TO_EMAIL=info@liays.ca

# Must be an address on a domain verified in Resend.
# send.liays.ca is verified — SPF and MX at send.send.liays.ca, DKIM at
# resend._domainkey.send.liays.ca. The subdomain keeps Resend's records clear
# of Hostinger's, which own MX and SPF on the root domain for the real inbox.
# Two SPF records on one domain breaks mail delivery, so never add one at the root.
RESEND_FROM_EMAIL=hello@send.liays.ca

# Optional. Raises the quota for the /audit tool's PageSpeed checks.
PAGESPEED_API_KEY=
